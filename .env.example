# Database Configuration (SQLite by default for zero-config local run; switchable to PostgreSQL)
DATABASE_URL="file:./dev.db"

# Google Gemini API Key (Optional: system provides deterministic heuristic fallback if unset)
GEMINI_API_KEY="your-gemini-api-key-here"

# Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="DealerOS"
DEFAULT_ORG_ID="org_apex_motors"

# External Integrations (Simulated / Mocked by default)
NHTSA_VIN_API_URL="https://vpic.nhtsa.dot.gov/api/vehicles/decodevin"
ENABLE_MOCK_MARKETPLACES="true"
