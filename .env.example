# ==============================================================================
# AutoAIdealership — Production Environment Variables Reference (.env.example)
# Domain: autoaidealership.com
# ==============================================================================

# PostgreSQL Database Connection (Required for production deployments)
DATABASE_URL="postgresql://postgres:password@localhost:5432/autoaidealership?schema=public"

# Core Application Settings
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="AutoAIdealership"
NEXT_PUBLIC_APP_DOMAIN="autoaidealership.com"
DEFAULT_ORG_ID="org_apex_motors"

# Optional Product Demo Video (Unset defaults to interactive UI placeholder poster)
NEXT_PUBLIC_PRODUCT_DEMO_VIDEO_URL=""

# AI Engine Configuration (Gemini API)
GEMINI_API_KEY=""

# JWT Session Authentication & Vault Secrets (Must be random 32+ character strings in production)
SESSION_SECRET="super-secret-jwt-key-change-in-production-32chars"
ENCRYPTION_SECRET="super-secret-encryption-vault-key-32chars!"

# VinAudit API Suite (Server-side only; unset activates metered mock adapter)
VINAUDIT_API_KEY=""

# Third-Party Vehicle History Providers (Commercial credentials required for live queries)
CARFAX_API_KEY=""
AUTOCHECK_API_KEY=""

# Government / Open APIs (Publicly available)
NHTSA_VIN_API_URL="https://vpic.nhtsa.dot.gov/api/vehicles/decodevin"

# Marketplace & Syndication Flags
ENABLE_MOCK_MARKETPLACES="true"
